# NVIDIA L40S (Ada Lovelace, AD102, sm_89) -- MICROBENCHMARK-TUNED, NOT YET
# CORRELATED AGAINST NCU
#
# Derived from SM86_RTX3070: the Ada SM is architecturally a GA10x SM
# (4 sub-cores, 128 FP32 lanes, 64K regs, 128 KB unified L1/shmem), so the
# core pipeline is inherited and the chip-level parameters are rescaled.
# Latencies were then measured with GPU_Microbenchmark + util/tuner on a
# Gautschi L40S (g002, driver 595.71.05, 2026-10-17).
#
# Provenance tags used below:
#   [SPEC]      NVIDIA L40S datasheet / CUDA Programming Guide (cc 8.9 limits)
#   [MEASURED]  measured on the L40S node (microbenchmarks, nvidia-smi, CUPTI)
#   [MEASURE]   must be replaced with a value measured on the L40S node
#               (deviceQuery, nvidia-smi, ncu) before trusting results
#   [INHERITED] copied from SM86_RTX3070 unchanged
#   [TUNE]      latency/throughput knob, tune with GPU_Microbenchmark + util/tuner
#
# See L40S_trace_validation.md at the Accel-Sim root for the full procedure.

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 89

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
# [MEASURED] fitted to CUPTI kernel times (2026-10-17). The kernel_lat
#   microbenchmark only prints a hard-coded 5000. The launch latency adds
#   exactly this many cycles per kernel. 2400 minimizes the mean |error|
#   over 28 inputs (rodinia_2.0-ft + rodinia-3.1): 15.2%, against 40.1% at 5000.
#   The best value is 3100 on rodinia_2.0-ft alone and 2100 on rodinia-3.1 alone.
-gpgpu_kernel_launch_latency 2400
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 8
-gpgpu_compute_capability_minor 9

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
# [SPEC][MEASURE] 142 SMs; confirm deviceQuery "Multiprocessors"
-gpgpu_n_clusters 142
-gpgpu_n_cores_per_cluster 1
# [SPEC] 384-bit GDDR6 = 24 x 16-bit channels (same per-channel model as RTX3070)
-gpgpu_n_mem 24
-gpgpu_n_sub_partition_per_mchannel 2

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
# [MEASURED] Core/icnt/L2: 2520 MHz. Without an ncu clock lock the L40S ran at
#   its 2520 MHz max clock for the whole CUPTI timing run (nvidia-smi sampled
#   every 100 ms), and the microbenchmark latencies below are in 2520 MHz
#   cycles. If you later correlate against ncu, which locks to the 1110 MHz base
#   clock by default, use ncu's gpc__cycles_elapsed.avg.per_second here instead.
# [MEASURED] DRAM: nvidia-smi max memory clock / 2 (same rule that gives 3500.5
#   for the RTX3070's 7001 MHz). 18 Gbps GDDR6 -> 9001 MHz -> 4500.5. (The
#   tuner's value is wrong: cudaDeviceProp.memoryClockRate reads 9 on this
#   driver.)
-gpgpu_clock_domains 2520:2520:2520:4500.5

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 89

# [SPEC] cc 8.9: 48 warps (1536 threads) and 24 CTAs per SM (the tuner's
#   core_config reports 32 CTAs, above the CUDA guide limit; kept at 24)
-gpgpu_shader_core_pipeline 1536:32
-gpgpu_shader_cta 24
-gpgpu_simd_model 1

# Pipeline widths and number of FUs [INHERITED]
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals [MEASURED] (config_int/fpu/
# dpu/sfu/tensor microbenchmarks; PTX mode only, trace mode uses trace.config)
# "ADD,MAX,MUL,MAD,DIV"
# All Div operations are executed on SFU unit
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 2,2,2,2,4
-ptx_opcode_latency_dp 54,54,54,54,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 23
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 33
-ptx_opcode_initiation_tensor 32

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# register banks [MEASURED] (regfile_bw)
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 2

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>,<data_port_width>
# ** Optional parameter - Required when mshr_type==Texture Fifo, set to 0 if not used
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
# [SPEC] cc 8.9: 128 KB unified L1/shmem, carveouts 0/8/16/32/64/100 KB
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100
-gpgpu_unified_l1d_size 128
# L1 cache configuration [INHERITED]; latency [MEASURED] (l1_lat). l1_config
# reports S:4:128:64, which is the L1 left by the default shared-memory
# carveout; the adaptive config above sizes L1 per kernel, so keep 256 ways.
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,16:0,32
-gpgpu_l1_latency 34
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
-gpgpu_shmem_size 102400
-gpgpu_shmem_sizeDefault 102400
-gpgpu_shmem_per_block 49152
# [MEASURED] (shared_lat)
-gpgpu_smem_latency 30
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 89

# L2 cache
# [SPEC][MEASURE] 96 MB total = 48 sub-partitions x 2 MB
#   (1024 sets x 128 B x 16 ways). Confirm deviceQuery "L2 Cache Size".
#   IPOLY set hashing only supports 16/32/64 sets, so use XOR hashing ('X')
#   as SM90_H100 does.
-gpgpu_cache:dl2 S:1024:128:16,L:B:m:L:X,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
# 48 sub-partitions is not a power of two: IPOLY_MODULO (16 groups x 3)
-gpgpu_memory_partition_indexing 6

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1

# memory partition latency config [MEASURED] (l2_lat, mem_lat), in 2520 MHz
# cycles. The 96 MB L2 is much larger than GA104's 4 MB, and both latencies
# are well above the RTX3070 values (187, 254).
-gpgpu_l2_rop_latency 238
-dram_latency 354

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# dram model config
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 2
-gpgpu_dram_burst_length 16
-dram_data_command_freq_ratio 4
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing [TUNE]
# RTX3070 GDDR6 timings with the latency terms scaled by 4500/3500 to hold
# their nanosecond values at the higher DRAM clock (CCD/CCDL/RTPL are
# burst-bound and left unchanged). The tuner's mem_config only rescales a
# reference GDDR6 table by the (misread) memory clock, so it isn't a
# measurement and isn't used here.
-gpgpu_dram_timing_opt nbk=16:CCD=4:RRD=15:RCD=31:RAS=71:RP=31:RC=102:CL=31:WL=10:CDLR=13:WR=31:nbkgrp=4:CCDL=6:RTPL=4
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
#-trace_enabled 1
#-trace_components WARP_SCHEDULER,SCOREBOARD
#-trace_sampling_core 0
